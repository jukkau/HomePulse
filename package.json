{
    "name": "homepulse",
    "version": "1.1.2",
    "description": "A component-based personal homepage dashboard with widgets, layouts, and knowledge workflow tools.",
    "main": "main.js",
    "scripts": {
        "build": "node esbuild.config.mjs production",
