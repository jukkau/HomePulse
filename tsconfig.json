{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noImplicitAny": false,
    "outDir": "dist",
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": [
      "node"
    ],
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
